local autoTrain = false
local autoRebirth = false

local function createToggle(text, parent, callback)
	local btn = Instance.new("TextButton", parent)
	btn.Size = UDim2.new(0, 280, 0, 30)
	btn.Position = UDim2.new(0, 20, 0, #parent:GetChildren() * 35)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btn.Text = "🔘 " .. text
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 14

	local enabled = false
	btn.MouseButton1Click:Connect(function()
		enabled = not enabled
		btn.Text = (enabled and "✅ " or "🔘 ") .. text
		callback(enabled)
	end)
end

createToggle("Auto Treino (5x)", pages.Farm, function(state)
	autoTrain = state
	while autoTrain and task.wait(0.2) do
		local args = {[1] = "WeightedPushup"}
		game:GetService("ReplicatedStorage").Events.Strength:FireServer(unpack(args))
	end
end)

createToggle("Auto Rebirth", pages.Farm, function(state)
	autoRebirth = state
	while autoRebirth and task.wait(1) do
		game:GetService("ReplicatedStorage").Rebirth:FireServer()
	end
end)

